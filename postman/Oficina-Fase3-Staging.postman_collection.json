              "mode": "raw",
              "raw": "{\n  \"documentoCliente\": \"{{cpf_cliente}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('status EM_EXECUCAO', () => pm.expect(pm.response.json().data.status).to.eql('EM_EXECUCAO'));"
                ]
              }
            }
          ]
        }
      ],
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{customer_token}}",
            "type": "string"
          }
        ]
      }
    },
    {
      "name": "06 · Ordem de serviço — execução e entrega (staff)",
      "description": "Fecha o ciclo da OS depois da aprovação do cliente.",
      "item": [
        {
          "name": "Detalhar a OS",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/ordens-servico/{{os_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "ordens-servico",
                "{{os_id}}"
              ]
            },
            "description": ""
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "console.log('status atual:', pm.response.json().data.status);"
                ]
              }
            }
          ]
        },
        {
          "name": "Finalizar",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/ordens-servico/{{os_id}}/finalizar",
              "host": [
