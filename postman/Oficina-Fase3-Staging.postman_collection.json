      "name": "08 · Métricas de negócio (staff)",
      "description": "Agregados exigidos pela Fase 3: ordens do período, duração por status e tempo de execução. Rode depois de fechar a OS para os números incluírem a ordem criada na gravação.",
      "item": [
        {
          "name": "Relatório de ordens por período",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/admin/relatorios/ordens?inicio={{relatorio_inicio}}&fimExclusive={{relatorio_fim}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "admin",
                "relatorios",
                "ordens"
              ],
              "query": [
                {
                  "key": "inicio",
                  "value": "{{relatorio_inicio}}"
                },
                {
                  "key": "fimExclusive",
                  "value": "{{relatorio_fim}}"
                }
              ]
            },
            "description": "`inicio` e `fimExclusive` são obrigatórios, no formato YYYY-MM-DD; o pre-request calcula a janela."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Janela do relatório: últimos 7 dias até amanhã (fim é exclusivo).",
                  "const dia = (deslocamento) => {",
                  "  const data = new Date();",
                  "  data.setUTCDate(data.getUTCDate() + deslocamento);",
                  "  return data.toISOString().slice(0, 10);",
                  "};",
                  "pm.environment.set('relatorio_inicio', dia(-7));",
                  "pm.environment.set('relatorio_fim', dia(1));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const dados = pm.response.json().data;",
                  "pm.test('conta ordens criadas', () => pm.expect(dados.criadas).to.be.a('number'));",
                  "console.log('ordens criadas na janela:', dados.criadas);",
                  "Object.entries(dados.duracoes).forEach(([status, d]) => console.log(status, '| amostras', d.amostras, '| média', d.mediaSegundos));"
                ]
              }
            }
          ]
        },
