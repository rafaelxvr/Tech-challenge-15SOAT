                  "const cpf = pm.environment.get('cpf_cliente');",
                  "const cliente = pm.response.json().data.content.find(c => c.documentoSomenteDigitos === cpf);",
                  "pm.test('cliente do CPF existe', () => pm.expect(cliente, 'cliente com CPF ' + cpf + ' não cadastrado').to.exist);",
                  "pm.environment.set('cliente_id', cliente.id);",
                  "console.log('cliente:', cliente.nome, '| e-mail do OTP:', cliente.email);"
                ]
              }
