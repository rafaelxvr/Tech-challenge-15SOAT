        {
          "name": "Localizar o cliente do CPF da demo",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/clientes?page=0&size=50",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
