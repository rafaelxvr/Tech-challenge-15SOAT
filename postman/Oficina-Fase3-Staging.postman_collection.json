      ],
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{staff_token}}",
            "type": "string"
          }
        ]
      }
    },
    {
      "name": "03 · Ordem de serviço — abertura e orçamento (staff)",
      "description": "Cadastra o veículo, abre a OS, executa o diagnóstico e envia o orçamento. Ao final a OS fica em `AGUARDANDO_APROVACAO`, esperando a decisão do cliente.",
      "item": [
        {
          "name": "Cadastrar veículo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/veiculos",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "veiculos"
              ]
            },
            "description": "A placa é sorteada no pre-request para a gravação ser repetível.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"placa\": \"{{veiculo_placa}}\",\n  \"marca\": \"Volkswagen\",\n  \"modelo\": \"Gol G6\",\n  \"ano\": 2018,\n  \"cor\": \"Prata\",\n  \"chassi\": \"9BWZZZ377VT004251\",\n  \"clienteId\": \"{{cliente_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Placa Mercosul aleatória: cada gravação cria um veículo novo.",
                  "if (!pm.environment.get('veiculo_placa')) {",
                  "  const letras = 'ABCDEFGHJKLMNPQRSTUVWXYZ';",
                  "  const sorteia = (origem, n) => Array.from({length: n}, () => origem[Math.floor(Math.random() * origem.length)]).join('');",
                  "  pm.environment.set('veiculo_placa', sorteia(letras, 3) + sorteia('0123456789', 1) + sorteia(letras, 1) + sorteia('0123456789', 2));",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const veiculo = pm.response.json().data;",
                  "pm.environment.set('veiculo_id', veiculo.id);",
                  "console.log('veículo:', veiculo.placa);"
                ]
              }
            }
          ]
        },
        {
          "name": "Abrir OS com orçamento automático",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/ordens-servico",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "ordens-servico"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"documentoCliente\": \"{{cpf_cliente}}\",\n  \"placaVeiculo\": \"{{veiculo_placa}}\",\n  \"marca\": \"Volkswagen\",\n  \"modelo\": \"Gol G6\",\n  \"ano\": 2018,\n  \"servicos\": [\n    {\n      \"servicoId\": \"{{servico_id}}\",\n      \"quantidade\": 1,\n      \"observacao\": \"Serviço solicitado pelo cliente\"\n    }\n  ],\n  \"pecas\": [\n    {\n      \"pecaId\": \"{{peca_id}}\",\n      \"quantidade\": 1\n    }\n  ],\n  \"observacoes\": \"Cliente relata barulho ao frear\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const os = pm.response.json().data;",
                  "pm.environment.set('os_id', os.id);",
                  "pm.environment.set('os_numero', os.numero);",
                  "pm.test('nasce em RECEBIDA', () => pm.expect(os.status).to.eql('RECEBIDA'));",
                  "console.log('OS', os.numero, '| total', os.valorTotal);"
                ]
              }
            }
          ]
        },
        {
          "name": "Iniciar diagnóstico",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/ordens-servico/{{os_id}}/iniciar-diagnostico",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "ordens-servico",
                "{{os_id}}",
                "iniciar-diagnostico"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"observacao\": \"Mecânico iniciou a inspeção\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('status EM_DIAGNOSTICO', () => pm.expect(pm.response.json().data.status).to.eql('EM_DIAGNOSTICO'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Enviar orçamento ao cliente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/ordens-servico/{{os_id}}/enviar-orcamento",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "ordens-servico",
                "{{os_id}}",
                "enviar-orcamento"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"observacao\": \"Orçamento enviado por e-mail\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('status AGUARDANDO_APROVACAO', () => pm.expect(pm.response.json().data.status).to.eql('AGUARDANDO_APROVACAO'));"
                ]
              }
            }
          ]
        }
      ],
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{staff_token}}",
            "type": "string"
          }
        ]
      }
    },
    {
      "name": "04 · Cliente — autenticação por CPF (OTP)",
      "description": "Fluxo serverless: a Lambda emite um desafio, envia o código por e-mail (SES) e troca o código por um JWT RS256 de cliente. O desafio expira em 5 minutos e o token vale 15 minutos — rode esta pasta imediatamente antes da aprovação.",
      "item": [
        {
          "name": "Solicitar desafio por CPF",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/cpf/desafios",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "cpf",
                "desafios"
              ]
            },
            "description": "Rota anônima. O código de 6 dígitos chega no e-mail do cliente.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cpf\": \"{{cpf_cliente}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));",
                  "const dados = pm.response.json().data;",
                  "pm.environment.set('desafio_id', dados.desafioId);",
                  "pm.environment.unset('otp_codigo');",
                  "console.log('desafio', dados.desafioId, '| expira em', dados.expiraEmSegundos, 'segundos');",
                  "console.log('>>> copie o código do e-mail para a variável otp_codigo e rode a próxima requisição.');"
                ]
              }
            }
          ]
        },
        {
          "name": "Trocar o código pelo token do cliente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/cpf/verificar",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "cpf",
                "verificar"
              ]
            },
            "description": "Preencha `otp_codigo` no environment com o código recebido antes de enviar.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"desafioId\": \"{{desafio_id}}\",\n  \"codigo\": \"{{otp_codigo}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const codigo = pm.environment.get('otp_codigo');",
                  "if (!codigo || !/^[0-9]{6}$/.test(codigo)) {",
                  "  throw new Error('Preencha otp_codigo no environment com os 6 dígitos recebidos por e-mail.');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const dados = pm.response.json().data;",
                  "pm.environment.set('customer_token', dados.accessToken);",
                  "const claims = JSON.parse(atob(dados.accessToken.split('.')[1].replace(/-/g, '+').replace(/_/g, '/')));",
                  "pm.test('principal é customer', () => pm.expect(claims.principal_type).to.eql('customer'));",
                  "pm.test('escopos self', () => pm.expect(claims.scopes).to.have.members(['orders:read:self', 'orders:decide:self']));",
                  "console.log('token de cliente para', claims.sub, '| expira em', dados.expiresIn, 'segundos');"
                ]
              }
            }
          ]
        }
      ],
      "auth": {
        "type": "noauth"
      }
    },
    {
      "name": "05 · Cliente — acompanhamento e aprovação",
      "description": "Rotas que só aceitam token de cliente com escopo `orders:read:self` e `orders:decide:self`. Endereçadas pelo número da OS, não pelo id.",
