# Copie este arquivo para .env e ajuste os valores
# NUNCA commit o arquivo .env no repositório

# ========================
#    BANCO DE DADOS
# ========================
DB_URL=jdbc:postgresql://localhost:5432/oficina_mecanica
DB_USERNAME=oficina
DB_PASSWORD=oficina123

# ========================
#    JWT - TROQUE EM PRODUÇÃO
# ========================
JWT_SECRET=
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000
# Required environment-specific trust; see docs/runbooks/jwt-trust.md.
JWT_STAFF_ISSUER=
JWT_STAFF_AUDIENCE=
JWT_STAFF_KEY_ID=
JWT_CUSTOMER_ISSUER=
JWT_CUSTOMER_AUDIENCE=
# JSON containing security.jwt.customer.public-keys (kid -> PEM public key).
SPRING_APPLICATION_JSON=

# ========================
#    SERVIDOR
# ========================
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ========================
#    E-MAIL (MailHog local)
# ========================
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_ENABLED=true
MAIL_FROM=noreply@oficina.com
MAIL_STATUS_TOKEN=oficina-email-status-token

# ========================
#    SONARQUBE (análise)
# ========================
# URL do servidor (Compose expõe em http://localhost:9000)
SONAR_HOST_URL=http://localhost:9000
# Gere em: SonarQube → My Account → Security → Generate Token
SONAR_TOKEN=

# Explicit provenance for NEW synthetic fixtures only. Existing deployments must
# establish their legacy writer zone before cutover (docs/runbooks/first-writer-cutover.md).
HISTORICO_ZONA_COMPATIBILIDADE=UTC
